{#- reference/app/views/layouts/application.html.erb. Blocks stand for the ERB's yields:
    head/nav/footer/sidebar are content_for areas, content is the view. Whitespace follows
    the ERB output (a block tag at the end of a line eats its newline, hence the blank lines). -#}
<!DOCTYPE html>
<html>
  <head>
    {{ page_title_tag() }}

    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    {{ csrf_meta_tags() }}
    {{ csp_meta_tag() }}
    {{ current_user_meta_tags() }}
    {{ script_aware_action_cable_meta_tag() }}

    {{ vapid_public_key_meta_tag() }}
    {{ html_tag('meta', {name: 'turbo-prefetch', content: 'true'}) }}

    {{ html_tag('link', {rel: 'manifest', href: path('webmanifest', {_format: 'json'})}) }}
    {{ html_tag('link', {rel: 'icon', href: fresh_account_logo_path(), type: 'image/png'}) }}
    {{ html_tag('link', {rel: 'apple-touch-icon', href: fresh_account_logo_path()}) }}

    {{ stylesheet_link_tag('all', {'data-turbo-track': 'reload'}) }}
    {{ custom_styles_tag() }}

    {{ javascript_importmap_tags() }}

    {% block head %}{% endblock %}

  </head>

  <body class="{{ body_classes() }}" data-controller="local-time lightbox">
    <a href="#main-content" class="skip-navigation btn">Skip to main content</a>

    <nav id="nav">
      {% block nav %}{% endblock %}

    </nav>

    {%~ set notice = flash('notice') ?? flash('alert') %}
    {%~ if notice is not null %}
      <div class="flash" data-controller="element-removal" data-action="animationend->element-removal#remove">
        <div class="flash__inner shadow" style="{{ flash('alert') is not null ? '--flash-background: var(--color-negative)' }}">
          {%~ if flash('alert') is not null %}
            {{ image_tag('alert.svg', {aria: {hidden: true}, size: 24, class: 'colorize--white'}) }}</span>
          {%~ else %}
            {{ image_tag('check.svg', {aria: {hidden: true}, size: 24, class: 'colorize--white'}) }}</span>
          {%~ endif %}
        </div>
        <span class="for-screen-reader" role="alert" aria-atomic="true">{{ notice }}</span>
      </div>
    {%~ endif %}

    <main id="main-content">
      {% block content %}{% endblock %}

      <footer id="footer">
        {% block footer %}{% endblock %}

      </footer>
    </main>

    <aside id="sidebar" data-controller="toggle-class" data-toggle-class-toggle-class="open">
      {% block sidebar %}{% endblock %}

    </aside>

    {{ include('layouts/_lightbox.html.twig') }}

    <a href="https://once.com" id="app-logo" target="_blank" aria-label="Once software from 37signals home page">
      {{ image_tag('campfire-icon.png', {alt: 'Campfire logo', width: 256, height: 216}) }}
    </a>
  </body>
</html>
