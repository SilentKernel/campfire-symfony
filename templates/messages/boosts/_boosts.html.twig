{#- reference/app/views/messages/boosts/_boosts.html.erb. Variables: p (boosts are p.boosts), detached. #}
<turbo-frame id="{{ dom_id(p.message, 'boosting') }}">
  <div class="boosts flex flex-wrap align-center gap full-width" style="--column-gap: 0.4ch; --row-gap: 0"
      data-controller="turbo-streaming" data-action="turbo:submit-start->turbo-streaming#unsubscribe">
    <div class="flex-inline flex-wrap gap" id="{{ dom_id(p.message, 'boosts') }}" data-turbo-streaming-target="container">
      {% for boost in p.boosts %}{{ include('messages/boosts/_boost.html.twig') }}{% endfor %}{{ '' }}
    </div>

    <turbo-frame id="{{ dom_id(p.message, 'new_boost') }}">
      <div class="flex-inline message__boost-inline" data-controller="soft-keyboard">
        <a class="boost__action txt-small btn" action="soft-keyboard#open" href="{{ path('new_message_boost', {message_id: p.message.id}) }}">
          {{ image_tag('boost.svg', {size: 20, aria: {hidden: 'true'}}) }}
          <span class="for-screen-reader">Add a boost</span>
</a>      </div>
</turbo-frame>  </div>
</turbo-frame>
{{- '' -}}
