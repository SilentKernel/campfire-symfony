{#- reference/app/views/messages/edit.html.erb. Variables: p (App\View\MessagePresentation), room, editable_body. #}
{% extends 'layouts/application.html.twig' %}
{% block content %}
{% set message = p.message %}
{% set message_path = path('room_message', {room_id: room.id, id: message.id}) %}
<turbo-frame id="{{ dom_id(message, 'edit') }}">
  <div class="message__body position-relative" data-controller="scroll-into-view">
    <div class="message__body-content message__body-content--editing gap">
      {%~ if p.contentType == 'attachment' %}
        {{ message_attachment_presentation(message, p.attachment) }}

        <div class="message__edit-btns flex align-center justify-space-between gap full-width pad-block-start-half">
          <button name="button" type="submit" class="btn btn--negative center margin-block-end" form="{{ dom_id(message, 'delete_form') }}" data-turbo-confirm="Are you sure you want to delete this message?">
            {{ image_tag('trash.svg', {aria: {hidden: 'true'}}) }}
            <span class="for-screen-reader">Delete message</span>
</button>        </div>
      {%~ else %}
        <div class="composer--edit composer--rich-text">
          {{ form_with({url: message_path, method: 'patch', id: dom_id(message, 'form'), data: {controller: 'form', action: 'lexxy:file-accept->form#preventAttachment keydown.esc->form#cancel keydown.ctrl+enter->form#submit:prevent keydown.meta+enter->form#submit:prevent'}}) }}
            <div class="full-width input input--actor min-width fill-white">
              <lexxy-editor rows="1" class="input lexxy-content" aria-multiline="true" aria-label="Edit message" autofocus="autofocus" permitted-attachment-types="application/vnd.campfire.mention application/vnd.actiontext.opengraph-embed" data-action="lexxy:change-&gt;typing-notifications#start keydown-&gt;composer#submitByKeyboard:capture" data-direct-upload-url="{{ url('rails_direct_uploads') }}" data-blob-url-template="{{ url('rails_service_blob', {signed_id: ':signed_id', filename: ':filename'})|replace({'%3A': ':'}) }}" id="message_body" input="message_body_trix_input_{{ dom_id(message) }}" name="message[body]" value="{{ editable_body }}">
                <lexxy-prompt trigger="@" name="mention" src="{{ path('autocompletable_users', {room_id: room.id}) }}" remote-filtering="true" empty-results="No matches"></lexxy-prompt>
</lexxy-editor>            </div>

            <a data-form-target="cancel" hidden="hidden" href="{{ message_path }}">Close editor and discard changes</a>

            <div class="message__edit-btns flex align-center justify-space-between gap full-width pad-block-start-half">
              <button name="button" type="submit" class="btn btn--reversed">
                {{ image_tag('check.svg', {aria: {hidden: 'true'}}) }}
                <span class="for-screen-reader">Save changes</span>
</button>
              <button name="button" type="submit" class="btn btn--negative" form="{{ dom_id(message, 'delete_form') }}" data-turbo-confirm="Are you sure you want to delete this message?">
                {{ image_tag('trash.svg', {aria: {hidden: 'true'}}) }}
                <span class="for-screen-reader">Delete message</span>
</button>            </div>
</form>        </div>
      {%~ endif %}
    </div>

    <div class="message__actions flex flex-wrap">
      <a class="message__action-btn message__edit-close-btn txt-small btn btn--borderless" href="{{ message_path }}">
        {{ image_tag('remove.svg', {class: 'colorize--black', aria: {hidden: 'true'}}) }}
        <span class="for-screen-reader">Close editor and discard changes</span>
</a>    </div>

    {{ form_with({url: message_path, method: 'delete', id: dom_id(message, 'delete_form'), data: {turbo_frame: dom_id(message, 'edit')}}) }}
  </div>
</turbo-frame>

{% endblock %}
