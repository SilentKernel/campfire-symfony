{#- reference/app/views/welcome/show.html.erb -#}
{% extends turbo_frame_request() ? 'layouts/turbo_rails/frame.html.twig' : 'layouts/application.html.twig' %}
{% set page_title = 'No rooms yet' %}
{% set body_class = 'sidebar' %}

{% block sidebar %}{{ sidebar_turbo_frame_tag(path('user_sidebar')) }}{% endblock %}

{% block content %}

<div id="message-area" class="message-area">
  <div class="message-area--empty min-width center">
    <figure class="center pad">
      {{ image_tag('messages-empty.svg', {aria: {hidden: 'true'}, class: 'colorize--black translucent'}) }}
      <span class="for-screen-reader">{{ current_user().name }}</span>
    </figure>
  </div>
</div>
{% endblock %}
