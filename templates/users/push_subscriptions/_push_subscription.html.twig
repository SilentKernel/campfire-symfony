{#- reference/app/views/users/push_subscriptions/_push_subscription.html.erb; `agent` is
    "#{agent.browser} #{agent.version} on #{agent.platform}" of UserAgent.parse(user_agent). -#}
<li class="flex flex-column margin-none membership-item">
  <span class="overflow-ellipsis txt-primary txt-undecorated">
    <strong>{{ push_subscription.agent }}</strong><br>
  </span>

  <span class="flex align-start gap txt-small">
    <span>{{ push_subscription.record.endpoint }}</span>

    <span class="flex align-center gap">
      {%- set test %}
        {{ image_tag('notification-bell-everything.svg', {aria: {hidden: 'true'}, size: 20}) }}
        <span class="for-screen-reader">Send test notification</span>
{% endset %}
      {{ button_to(test, path('user_push_subscription_test_notifications', {push_subscription_id: push_subscription.record.id}), {class: 'btn btn--reversed'}) }}

      {%- set delete %}
        {{ image_tag('minus.svg', {aria: {hidden: 'true'}, size: 20}) }}
        <span class="for-screen-reader">Delete subscription</span>
{% endset %}
      {{ button_to(delete, path('user_push_subscription.delete', {id: push_subscription.record.id}), {method: 'delete', class: 'btn btn--negative'}) }}    </span>
  </span>
</li>
