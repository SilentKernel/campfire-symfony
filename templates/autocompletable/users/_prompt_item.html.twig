{#- reference/app/views/autocompletable/users/_prompt_item.html.erb; the users/_mention partial
    is written out. -#}
{% set sgid = attachable_sgid(user) -%}
<lexxy-prompt-item search="{{ user.name }}" sgid="{{ sgid }}">
  <template type="menu">
    <span class="autocomplete__item flex align-center gap unpad">
      {{ avatar_tag(user) }}
      <span class="autocompletable__name">{{ user.name }}</span>
    </span>
  </template>
  <template type="editor">
    <span class="mention" sgid="{{ sgid }}">{{ avatar_tag(user) }} {{ user.name }}</span>

  </template>
</lexxy-prompt-item>
