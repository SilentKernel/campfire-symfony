{#- reference/app/views/accounts/edit.html.erb. `form_with model: @account` targets the singular
    resource's path with the record as the format: "/account.<id>". -#}
{% extends turbo_frame_request() ? 'layouts/turbo_rails/frame.html.twig' : 'layouts/application.html.twig' %}
{% set page_title = 'Account settings' %}
{% set account_path = path('account.patch') ~ '.' ~ account.id %}

{% block nav %}
  <div class="flex-item-justify-start">
    {{ link_back_to_last_room_visited() }}
  </div>

{% if current_user().isAdministrator() %}
    <div class="flex align-center gap flex-item-justify-end">
      {%- set bots %}
        {{ image_tag('bot.svg', {aria: {hidden: 'true'}, size: 20}) }}
        <span class="for-screen-reader">Set up chat bots</span>
{% endset %}
      {{ link_to(bots, path('account_bots'), {class: 'btn', style: 'view-transition-name: chat-bots'}) }}

      {%- set styles %}
        {{ image_tag('art.svg', {size: 20, aria: {hidden: 'true'}}) }}
        <span class="for-screen-reader">Custom styles</span>
{% endset %}
      {{ link_to(styles, path('edit_account_custom_styles'), {class: 'btn', style: 'view-transition-name: custom-styles'}) }}    </div>
{% endif %}
{% endblock %}

{% block content %}

<section class="panel txt-align-center flex flex-column gap" style="view-transition-name: account-settings">
{% if current_user().canAdminister() %}
    <div class="align-center center avatar__form gap" data-controller="upload-preview">
      {{ form_with({url: account_path, method: 'patch', class: 'txt--medium', data: {controller: 'form'}, multipart: true}) }}
        <label class="btn input--file">
          {{ image_tag('camera.svg', {aria: {hidden: 'true'}, size: 20}) }}
          <input class="input" accept="image/*" data-action="upload-preview#previewImage change-&gt;form#submit" type="file" name="account[logo]" id="account_logo" />
          <span class="for-screen-reader">Upload logo</span>
        </label>
</form>
      {{ form_with({url: account_path, method: 'patch', data: {controller: 'form'}, multipart: true}) }}
        <label class="btn avatar input--file account-logo txt-xx-large">
          {{ image_tag(fresh_account_logo_path(), {role: 'presentation', size: 48, data: {upload_preview_target: 'image'}}) }}
          <input class="input" accept="image/*" data-action="upload-preview#previewImage change-&gt;form#submit" type="file" name="account[logo]" id="account_logo" />
          <span class="for-screen-reader">Upload logo</span>
        </label>
</form>
{% if account_logo_attached() %}
        {%- set delete_logo %}
          {{ image_tag('minus.svg', {aria: {hidden: 'true'}, size: 20}) }}
          <span class="for-screen-reader">Delete logo</span>
{% endset %}
        {{ button_to(delete_logo, fresh_account_logo_path(), {method: 'delete', class: 'btn btn--negative txt-small avatar__delete-btn'}) }}
{% endif %}
    </div>

    {{ form_with({url: account_path, method: 'patch', data: {controller: 'form'}, class: 'flex flex-column gap'}) }}
      <div class="flex align-center gap">
        {{ translation_button('account_name') }}

        <label class="flex align-center gap flex-item-grow">
          <input class="input txt-large" autocomplete="off" placeholder="Name this account" autofocus="autofocus" data-action="keydown.enter-&gt;form#submit" type="text" value="{{ account.name }}" name="account[name]" id="account_name" />
        </label>

        <button name="button" type="submit" class="btn btn--reversed center">
          {{ image_tag('check.svg', {aria: {hidden: 'true'}, size: 20}) }}
          <span class="for-screen-reader">Save changes</span>
</button>      </div>
</form>
    <div class="margin-block-start pad-block pad-inline-double fill-shade border-radius">
      {{ form_with({url: account_path, method: 'put', data: {controller: 'form'}, class: 'flex align-center gap center'}) }}
        <div class="flex-item-grow flex align-center gap txt-align-start">
          {{ image_tag('crown.svg', {class: 'colorize--black', aria: {hidden: 'true'}, size: 18}) }} Must be admin to create new rooms
        </div>
        
          <input value="{{ current_account().restrictsRoomCreationToAdministrators() ? 'false' : 'true' }}" type="hidden" name="account[settings][restrict_room_creation_to_administrators]" id="account_settings_restrict_room_creation_to_administrators" />

        <label class="switch">
          <input type="checkbox"
                class="switch__input"
                {{ current_account().restrictsRoomCreationToAdministrators() ? 'checked' }}
                data-action="change->form#submit">
          <span class="switch__btn round"></span>
          <span class="for-screen-reader">
            Must be admin to create new rooms
          </span>
        </label>

</form>    </div>
{% else %}
    {{ account_logo_tag('txt-xx-large center') }}
    <h1 class="flex-item-grow txt-x-large">{{ account.name }}</h1>
{% endif %}

  <div class="margin-block pad-inline pad-block-start fill-shade border-radius">
    {{ include('accounts/_invite.html.twig') }}

    <hr class="margin-block separator full-width" style="--border-style: solid">

    <menu class="flex flex-column gap margin-none pad">
      <turbo-frame id="account_users">
        {% for user in administrators %}{{ include('accounts/users/_user.html.twig') }}{% endfor %}

{% if administrators is not empty and members is not empty %}
          <hr class="separator full-width" style="--border-style: solid">
{% endif %}

        {% for user in members %}{{ include('accounts/users/_user.html.twig') }}{% endfor %}
        {% if not page.last %}{{ include('accounts/users/_next_page_container.html.twig', {page: page.next}) }}{% endif %}
      </turbo-frame>
    </menu>
  </div>
</section>
{% endblock %}

{% block footer %}
  <div class="txt-align-center center margin-block-double txt-subtle">Campfire&trade; version {{ version_badge() }}</div>
{% endblock %}
