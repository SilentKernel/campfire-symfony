{#- reference/app/views/rooms/show/_nav.html.erb (content_for :nav) -#}
  {% if account_logo_attached() %}{{ account_logo_tag() }}{% endif %}

  <span class="btn btn--reversed btn--faux room--current">
    <h1 class="room__contents txt-medium overflow-ellipsis">
      {%- if room.direct %}
        <span class="for-screen-reader">Ping with</span>
      {%- endif %}

      {{ room_display_name(room) }}
    </h1>
</span>
  {%- set settings_link %}
    {{ image_tag('menu-dots-horizontal.svg', {size: 20, aria: {hidden: 'true'}}) }}
    <span class="for-screen-reader">Settings for this {{ room.direct ? 'Ping' : 'room' }}</span>
{% endset %}
  {{ link_to_edit_room(room, settings_link) }}
  {{ include('rooms/involvements/_bell.html.twig') }}
