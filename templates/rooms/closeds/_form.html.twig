{#- reference/app/views/rooms/closeds/_form.html.erb -#}
{% embed 'rooms/layouts/_form.html.twig' %}
  {% block access %}
    {%- set menu %}
    {% if can_administer %}
      <li class="flex align-center gap margin-none">
        <figure class="avatar flex-item-no-shrink" style="--avatar-border-radius: 0; --avatar-size: 4ch;">
          {{ image_tag('everyone.svg', {aria: {hidden: 'true'}, class: 'colorize--black', style: 'background-color: transparent'}) }}
          <span class="for-screen-reader">Everyone</span>
        </figure>

        <div class="min-width">
          <div class="overflow-ellipsis fill-shade"><strong>Everyone</strong></div>
        </div>

        <hr class="separator" aria-hidden="true">

        {%- set switch %}
          <label for="room_type" class="switch">
            <input type="checkbox" id="room_type" class="switch__input">
            <span class="switch__btn round"></span>
            <span class="for-screen-reader">Give everyone access to this room</span>
          </label>
{% endset %}
        {{ link_to(switch, type_change_path, {class: 'btn--faux flex-inline', tabindex: '-1', data: {turbo_action: 'replace'}}) }}
      </li>

      <hr class="separator full-width" style="--border-style: solid">
    {% endif %}

    {% if selected_users|length + unselected_users|length > 20 %}{{ user_filter_search_tag() }}{% endif %}

    <div data-filter-target="list" contents>
      {% for user in selected_users %}{{ include('rooms/closeds/_user.html.twig', {selected: true}) }}{% endfor %}

      {% if selected_users is not empty and unselected_users is not empty %}
        <hr class="separator full-width" style="--border-style: solid">
      {% endif %}

      {% for user in unselected_users %}{{ include('rooms/closeds/_user.html.twig', {selected: false}) }}{% endfor %}
    </div>
{% endset %}
    {{ user_filter_menu_tag(menu) }}
  {% endblock %}
{% endembed %}
