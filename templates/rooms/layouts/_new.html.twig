{#- reference/app/views/rooms/layouts/_new.html.erb, as a layout: views extend it and fill the
    `room_form` block. -#}
{% extends turbo_frame_request() ? 'layouts/turbo_rails/frame.html.twig' : 'layouts/application.html.twig' %}
{% set page_title = 'New chat room' %}

{% block nav %}
  <div class="flex-item-justify-start">
    {{ link_back_to_last_room_visited() }}
  </div>
{% endblock %}

{% block content %}
<section class="panel txt-align-center" style="view-transition-name: {{ view_transition_name ?? 'new-room' }}">
  {% block room_form %}{% endblock %}
</section>
{% endblock %}
