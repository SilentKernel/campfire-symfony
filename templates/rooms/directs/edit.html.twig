{#- reference/app/views/rooms/directs/edit.html.erb -#}
{% extends turbo_frame_request() ? 'layouts/turbo_rails/frame.html.twig' : 'layouts/application.html.twig' %}
{% set page_title = 'Edit settings for ' ~ room_display_name(room) %}

{% block nav %}
  <div class="flex-item-justify-start">
    {{ link_back_to_last_room_visited() }}
  </div>
{% endblock %}

{% block content %}
<div class="panel txt-align-center">
  <section class="directs--edit margin-block-end">
    {% for user in users %}
      <div class="member flex flex-column gap fill-shade pad border-radius">
        <figure class="avatar center" style="--avatar-border-radius: 10ch; --avatar-size: 10ch;" >
          {{ avatar_tag(user, {loading: 'lazy'}) }}
        </figure>

        <strong>{{ user.name }}</strong>
      </div>
    {% endfor %}
  </section>

  {%- set delete %}
    {{ image_tag('trash.svg', {aria: {hidden: 'true'}}) }}
    Ping
{% endset %}
  {{ button_to(delete, url('rooms_direct', {id: room.id}), {method: 'delete', class: 'btn btn--negative center', aria: {label: 'Delete Ping'}, data: {turbo_confirm: 'Are you sure you want to delete this ping and all messages in it? This can’t be undone.'}}) }}
</div>
{% endblock %}
