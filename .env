# Campfire reads the same environment variables as the Rails app it replaces. Real values come
# from the container environment; this file only provides defaults. See README.md.
#
#   SECRET_KEY_BASE        signs and encrypts cookies, signed ids and stream names (required)
#   CAMPFIRE_STORAGE_PATH  root holding db/ (SQLite databases) and files/ (Active Storage blobs)
#   DISABLE_SSL            when set, serve plain HTTP and don't mark cookies secure
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY   Web Push keys (keep an existing install's keys)
#   APP_VERSION / GIT_REVISION             reported in X-Version / X-Rev headers

APP_ENV=prod
APP_DEBUG=0
SECRET_KEY_BASE=
DEFAULT_URI=http://example.org
APP_VERSION=
GIT_REVISION=
DISABLE_SSL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
LOCK_DSN=flock
