#!/usr/bin/env bash
# Run campfire-symfony as the candidate of once-campfire-rust's parity harness.
#
# A modified copy of once-campfire-rust parity/bin/candidate (same interface). It drives the Rust
# checkout's harness in place ($BENCH_HOME/once-campfire-rust: parity/bin/reference, parity/bin/compare,
# the seeds in parity/.seed, the capture image) without editing any of its tracked files; only the
# candidate container differs: campfire-symfony-candidate (tools/parity/docker on top of
# campfire-symfony:app) instead of the Rust app. Run it inside the Linux runner:
#
#   bench/bin/runner tools/parity/bin/candidate build
#   bench/bin/runner tools/parity/bin/candidate up   [--seed NAME] [--port N] [--time ISO8601 [--freeze]] [-e K=V]
#   bench/bin/runner tools/parity/bin/candidate down [--port N | --all [--everyone]]
#   bench/bin/runner tools/parity/bin/candidate logs [--port N] [-f]
#   bench/bin/runner tools/parity/bin/candidate ps   [--everyone]
#   bench/bin/runner tools/parity/bin/candidate reset --port N [--app reference|candidate] [--seed NAME] [--time ISO8601]
#   bench/bin/runner tools/parity/bin/candidate compare [--seed NAME] [--ports REF,CAND] [--isolated N] [--time ISO8601] [OPTIONS]
#
# Differences from the Rust script:
#   * the harness checkout is $PARITY_RUST, default $BENCH_HOME/once-campfire-rust-symfony: the copy
#     tools/parity/bin/setup makes of $BENCH_HOME/once-campfire-rust with the AssetMapper digest patch.
#   * images: campfire-symfony:app -> campfire-symfony-candidate; containers campfire-symfony-cand-PORT.
#   * the container listens on HTTP_PORT=80 (Caddy), cable on TARGET_PORT=81 (bin/start defaults),
#     PHP_WORKERS=${PARITY_PHP_WORKERS:-4} (bin/start would take 2 x the host's CPUs).
#   * PARITY_NO_FAKETIME=1 runs without libfaketime (CAMPFIRE_FROZEN_TIME only).
#   * compare's --reset-host points at this script.
set -euo pipefail

SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
SYMFONY=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
BENCH_HOME=${BENCH_HOME:-/opt/campfire-bench}
ROOT=${PARITY_RUST:-$BENCH_HOME/once-campfire-rust-symfony}
PARITY=$ROOT/parity
SEEDS=${PARITY_SEED_DIR:-$PARITY/.seed}
INSTANCES=$SEEDS/.symfony-candidates
APP_IMAGE=${PARITY_CANDIDATE_APP_IMAGE:-campfire-symfony:app}
IMAGE=${PARITY_CANDIDATE_IMAGE:-campfire-symfony-candidate}
ENV_FILE=$PARITY/.env.reference
DEFAULT_PORT=3200
OWNER=${PARITY_OWNER:-${CLAUDE_CODE_SESSION_ID:-$(id -un)}}

die() { echo "candidate: $*" >&2; exit 1; }
log() { echo "candidate: $*" >&2; }

[ -x "$PARITY/bin/compare" ] || die "no parity harness at $PARITY (bench/bin/runner bench/bin/setup)"

SEED="" PORT="" TIME="" FREEZE="" FOLLOW="" ALL="" EVERYONE="" APP="" EXTRA_ENV=()

parse_options() {
  REST=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --seed)    SEED=$2; shift 2 ;;
      --port)    PORT=$2; shift 2 ;;
      --time)    TIME=$2; shift 2 ;;
      --freeze)  FREEZE=1; shift ;;
      -e)        EXTRA_ENV+=("$2"); shift 2 ;;
      -f|--follow) FOLLOW=1; shift ;;
      --all)     ALL=1; shift ;;
      --everyone) EVERYONE=1; shift ;;
      --app)     APP=$2; shift 2 ;;
      --)        shift; REST+=("$@"); break ;;
      *)         REST+=("$@"); break ;;
    esac
  done
}

faketime_spec() {
  [ -n "$TIME" ] || return 0
  local t
  t=$(date -u -d "$TIME" '+%Y-%m-%d %H:%M:%S') || die "can't parse --time $TIME"
  if [ -n "$FREEZE" ]; then echo "$t"; else echo "@$t"; fi
}

copy_seed_into() {
  local seed=$1 dir=$2
  mkdir -p "$dir/db" "$dir/storage"
  [ -f "$SEEDS/$seed/db/production.sqlite3" ] || die "seed '$seed' isn't built: parity/bin/seed build $seed"
  cp -a --reflink=auto "$SEEDS/$seed/db/." "$dir/db/"
  cp -a --reflink=auto "$SEEDS/$seed/storage/." "$dir/storage/"
}

container() { echo "campfire-symfony-cand-$1"; }
instance_dir() { echo "$INSTANCES/$1"; }
alive() { [ "$(docker inspect -f '{{.State.Running}}' "$(container "$1")" 2>/dev/null)" = "true" ]; }

wait_until_up() {
  local port=$1
  for _ in $(seq 1 240); do
    curl -fsS -o /dev/null "http://127.0.0.1:$port/up" 2>/dev/null && return 0
    alive "$port" || { docker logs "$(container "$port")" 2>&1 | tail -n 40 >&2; die "instance on port $port exited during boot"; }
    sleep 0.25
  done
  docker logs "$(container "$port")" 2>&1 | tail -n 40 >&2
  die "instance on port $port didn't come up within 60s"
}

env_args() {
  local spec; spec=$(faketime_spec)
  printf '%s\n' --env-file "$ENV_FILE"
  printf '%s\n' -e "PHP_WORKERS=${PARITY_PHP_WORKERS:-4}"
  [ -z "${PARITY_NO_FAKETIME:-}" ] || printf '%s\n' -e "PARITY_NO_FAKETIME=1"
  if [ -n "$spec" ]; then printf '%s\n' -e "FAKETIME=$spec"; fi
  if [ -n "$FREEZE" ] && [ -n "$TIME" ]; then
    printf '%s\n' -e "CAMPFIRE_FROZEN_TIME=$(date -u -d "$TIME" '+%Y-%m-%dT%H:%M:%SZ')"
  fi
  local e; for e in "${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"}"; do printf '%s\n' -e "$e"; done
}

up() {
  local port=$1 seed=$2 dir; dir=$(instance_dir "$port")
  docker rm -f "$(container "$port")" >/dev/null 2>&1 || true
  rm -rf "$dir"; copy_seed_into "$seed" "$dir"
  local args=(); mapfile -t args < <(env_args)
  docker run -d --name "$(container "$port")" \
    --label parity.seed="$seed" --label parity.candidate.port="$port" --label parity.owner="$OWNER" \
    --label parity.symfony=1 \
    --cpus "${PARITY_CPUS:-2}" \
    --user "$(id -u):$(id -g)" \
    -p "127.0.0.1:$port:80" \
    "${args[@]}" \
    -v "$dir/db:/rails/storage/db" -v "$dir/storage:/rails/storage/files" \
    "$IMAGE" >/dev/null
  wait_until_up "$port"
}

down() {
  docker rm -f "$(container "$1")" >/dev/null 2>&1 || true
  rm -rf "$(instance_dir "$1")"
}

ports() {
  local owner=(); [ -n "$EVERYONE" ] || owner=(--filter "label=parity.owner=$OWNER")
  docker ps -a --filter label=parity.symfony=1 "${owner[@]}" --format '{{.Label "parity.candidate.port"}}'
}

build() {
  if [ -n "${PARITY_BUILD_APP:-}" ] || ! docker image inspect "$APP_IMAGE" >/dev/null 2>&1; then
    log "building $APP_IMAGE from $SYMFONY/Dockerfile"
    docker build -t "$APP_IMAGE" --build-arg APP_VERSION=parity --build-arg GIT_REVISION=parity "$SYMFONY"
  fi
  log "building $IMAGE from tools/parity/docker/Dockerfile on $APP_IMAGE"
  docker build -t "$IMAGE" --build-arg BASE_IMAGE="$APP_IMAGE" "$SYMFONY/tools/parity/docker"
}

seed_clock() {
  local labels=$SEEDS/$1/labels.json
  [ -f "$labels" ] || die "no seed $1 at $labels; run parity/bin/seed build $1"
  python3 -c 'import json,sys; l=json.load(open(sys.argv[1])); print(l.get("clock.now") or (l.get("clock") or {}).get("now") or "")' "$labels"
}

reset() {
  local port=${PORT:?reset needs --port} seed=${SEED:-default}
  local time=${TIME:-$(seed_clock "$seed")} app=${APP:-}
  if [ -z "$app" ]; then
    if docker inspect "campfire-reference-$port" >/dev/null 2>&1; then app=reference; else app=candidate; fi
  fi
  case "$app" in
    reference|expected)
      "$PARITY/bin/reference" down --port "$port" >/dev/null
      "$PARITY/bin/reference" up --seed "$seed" --port "$port" --time "$time" --freeze >/dev/null ;;
    *)
      TIME=$time FREEZE=1 up "$port" "$seed" ;;
  esac
}

compare() {
  local ports=4111,4112 isolated=3 rest=() seed=${SEED:-default} time=${TIME:-}
  while [ $# -gt 0 ]; do
    case "$1" in
      --ports) ports=$2; shift 2 ;;
      --isolated) isolated=$2; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  [ -n "$time" ] || time=$(seed_clock "$seed")
  local ref_port cand_port; IFS=, read -r ref_port cand_port <<<"$ports"
  COMPARE_REF_PORTS=("$ref_port") COMPARE_CAND_PORTS=("$cand_port")
  local k; for k in $(seq 1 "$isolated"); do
    COMPARE_REF_PORTS+=($((ref_port + 1000 * k))); COMPARE_CAND_PORTS+=($((cand_port + 1000 * k)))
  done
  trap compare_teardown EXIT INT TERM
  log "reference :$ref_port vs symfony candidate :$cand_port (seed $seed, clock frozen at $time)"
  "$PARITY/bin/reference" up --seed "$seed" --port "$ref_port" --time "$time" --freeze >/dev/null &
  local ref_pid=$!
  TIME=$time FREEZE=1 up "$cand_port" "$seed"
  wait "$ref_pid" || die "reference didn't come up"
  local status=0
  "$PARITY/bin/compare" --seed "$seed" --time "$time" \
    --expected "http://127.0.0.1:$ref_port" --actual "http://127.0.0.1:$cand_port" \
    --expected-name reference --actual-name candidate --isolated "$isolated" \
    --reset-host "'$SELF' reset --app {target} --port {port} --seed '$seed' --time '$time'" \
    "${rest[@]+"${rest[@]}"}" &
  COMPARE_PID=$!
  wait "$COMPARE_PID" || status=$?
  COMPARE_PID=""
  return $status
}

compare_teardown() {
  local p
  if [ -n "${COMPARE_PID:-}" ]; then kill -TERM "$COMPARE_PID" 2>/dev/null || true; wait "$COMPARE_PID" 2>/dev/null || true; fi
  for p in "${COMPARE_REF_PORTS[@]}"; do "$PARITY/bin/reference" down --port "$p" >/dev/null 2>&1 || true; done
  for p in "${COMPARE_CAND_PORTS[@]}"; do down "$p"; done
}

cmd=${1:-help}; shift || true
if [ "$cmd" = compare ]; then
  pass=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --seed) SEED=$2; shift 2 ;;
      --time) TIME=$2; shift 2 ;;
      *) pass+=("$1"); shift ;;
    esac
  done
  compare "${pass[@]+"${pass[@]}"}"
  exit $?
fi
parse_options "$@"
set -- "${REST[@]+"${REST[@]}"}"

case "$cmd" in
  build)
    build ;;
  up)
    port=${PORT:-$DEFAULT_PORT} seed=${SEED:-default}
    up "$port" "$seed"
    echo "http://127.0.0.1:$port  (seed: $seed, symfony candidate${TIME:+, time: $(faketime_spec)})" ;;
  down)
    if [ -n "$ALL" ]; then
      for p in $(ports); do down "$p"; done
    else
      down "${PORT:-$DEFAULT_PORT}"
    fi ;;
  logs)
    if [ -n "$FOLLOW" ]; then docker logs -f "$(container "${PORT:-$DEFAULT_PORT}")"
    else docker logs "$(container "${PORT:-$DEFAULT_PORT}")"; fi ;;
  ps)
    for p in $(ports); do
      if alive "$p"; then echo "$p up"; else echo "$p down"; fi
    done ;;
  reset)
    reset ;;
  help|-h|--help)
    sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *)
    die "unknown command $cmd (try help)" ;;
esac
