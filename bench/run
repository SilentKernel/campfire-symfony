#!/usr/bin/env bash
# Benchmark Campfire implementations against each other on the same seed, workloads and CPUs:
# Rails (the reference), Django, Laravel (PHP-FPM; FrankenPHP classic and Octane worker mode), Express,
# Elixir, Go, Rust and Symfony (FrankenPHP classic and worker mode). Run it inside the runner:
#
#   bench/bin/runner bench/run [--apps rails,django,laravel,laravel-frankenphp-classic,laravel-frankenphp,express,elixir,go,rust,symfony-classic,symfony]
#                              [--reps 5] [--out DIR] [--user-agent UA]
# --apps takes any subset, e.g. the Laravel/Symfony grid on the same FrankenPHP runtime:
#   --apps laravel-frankenphp-classic,laravel-frankenphp,symfony-classic,symfony
#   bench/bin/runner bench/report DIR      # median [min–max] tables from a results dir
#
# Adapted from bench/run of once-campfire-rust (https://github.com/basecamp/once-campfire-rust,
# 64f8635), Copyright (c) 37signals, LLC, MIT licence. That harness, its load generator
# (bench/loadgen) and its seed (parity/.seed/default) produced the numbers published in the
# once-campfire README; the workloads, their parameters and the seed are unchanged here. Changes:
# any number of apps, each with its own image, environment, user and process model for the same
# CPUs; a Redis sidecar for multi-worker Django; cgroupfs paths (OrbStack); working copies on the
# Docker VM's filesystem; validation of every response, delivery, persisted write and the upload
# thumbnail; what the measured pages contain (bench/lib/validate.py page); image provenance
# (platform, digest, build revision) in env.txt; a failed rep is recorded, not fatal.
#
# Each rep, for each app in turn (never two at once; the order reverses on even reps): a fresh copy
# of the seed, a fresh container pinned to SERVER_CPUS, then cold start, idle memory, the HTTP
# suite, the Action Cable fan-out suite and the upload suite, with container memory sampled
# throughout and each process's memory, by role, during the fan-out (bench/lib/procmem.py). The
# load generator runs pinned to LOADGEN_CPUS; this script and its samplers to HARNESS_CPUS. Before
# each app's run it waits (up to LOAD_WAIT_SECS) for the 1-minute load average to drop below
# LOAD_MAX, and records it.
#
# Apps (`reference` is an alias of `rails`) and their images (unmodified production images, except
# Elixir's Thruster binary: see bench/bin/build-ports):
#   rails    RAILS_IMAGE     campfire-reference:app        bench/bin/setup (Rails at 254dd1d)
#   django   DJANGO_IMAGE    once-campfire-django:bench    bench/bin/build-ports
#   laravel  LARAVEL_IMAGE   once-campfire-laravel:bench   bench/bin/build-ports
#   laravel-frankenphp  LARAVEL_FRANKENPHP_IMAGE  once-campfire-laravel-frankenphp:bench
#                                                          (Octane + FrankenPHP; built from its own checkout)
#   laravel-frankenphp-classic  the same image, FRANKENPHP_MODE=classic
#   express  EXPRESS_IMAGE   once-campfire-express:bench   bench/bin/build-ports
#   elixir   ELIXIR_IMAGE    once-campfire-elixir:bench    bench/bin/build-ports
#   go       GO_IMAGE        once-campfire-go:bench        bench/bin/build-ports
#   rust     RUST_APP_IMAGE  once-campfire-rust:bench      bench/bin/build-ports
#   symfony-classic  SYMFONY_IMAGE  campfire-symfony:app   the same image, FRANKENPHP_MODE=classic
#   symfony  SYMFONY_IMAGE   campfire-symfony:app          this repository (worker mode)
#
# Environment, users and process models for the 4 CPUs: bench/lib/apps.sh. Extra env per app:
# <APP>_EXTRA_ENV (space-separated K=V; '-' as '_'), e.g. RUST_EXTRA_ENV, SYMFONY_CLASSIC_EXTRA_ENV.
#
# After the post_message HTTP route (warm-up included), while the app still runs, every
# acknowledged post must be a new `messages` row with its "bench write N" rich text body, in the
# FTS index, and PRAGMA integrity_check must be ok (bench/lib/validate.py writes; "writes" in each
# rep's JSON and in its validation).
#
# The load generator sends no User-Agent unless given one with --user-agent; a desktop Chrome, say:
#   --user-agent 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36'
#
# Knobs (env): SERVER_CPUS=0-3 LOADGEN_CPUS=4-7 HARNESS_CPUS=8-11 HTTP_SECS=8 HTTP_CONCS="1 16 64"
#   CABLE_CLIENTS="100 1000" CABLE_TPUT_SECS=15 CABLE_POSTERS=4 UPLOAD_REPS=5 PORT=4390
#   LOAD_MAX=1.5 LOAD_WAIT_SECS=900 SUITES="http cable upload" START_TIMEOUT=180 FAIL_FAST=
#   BENCH_WORK=$BENCH_HOME/work RUST_HOME=$BENCH_HOME/once-campfire-rust WRITE_SETTLE_SECS=10
# Ports that must be free on the Docker host: PORT, PORT+1, PORT+2, and 6379 for Rails' and
# Elixir's in-container Redis.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
BENCH=$ROOT/bench
BENCH_HOME=${BENCH_HOME:-/opt/campfire-bench}
RUST=${RUST_HOME:-$BENCH_HOME/once-campfire-rust}
SEED=$RUST/parity/.seed/default
LABELS=$SEED/labels.json
ENV_FILE=$RUST/parity/.env.reference
LOADGEN=$RUST/target/bench/release/loadgen
FIXTURE=$RUST/reference/test/fixtures/files/black_hole.jpg

SERVER_CPUS=${SERVER_CPUS:-0-3}
LOADGEN_CPUS=${LOADGEN_CPUS:-4-7}
HARNESS_CPUS=${HARNESS_CPUS:-8-11}
PROCMEM_CPUS=${PROCMEM_CPUS:-$HARNESS_CPUS}
HTTP_SECS=${HTTP_SECS:-8}
HTTP_CONCS=${HTTP_CONCS:-1 16 64}
CABLE_CLIENTS=${CABLE_CLIENTS:-100 1000}
CABLE_TPUT_SECS=${CABLE_TPUT_SECS:-15}
CABLE_POSTERS=${CABLE_POSTERS:-4}
UPLOAD_REPS=${UPLOAD_REPS:-5}
PORT=${PORT:-4390}
WRITE_SETTLE_SECS=${WRITE_SETTLE_SECS:-10}
LOAD_MAX=${LOAD_MAX:-1.5}
LOAD_WAIT_SECS=${LOAD_WAIT_SECS:-900}
START_TIMEOUT=${START_TIMEOUT:-180}
SUITES=${SUITES:-http cable upload}
WORK=${BENCH_WORK:-$BENCH_HOME/work}
BASE=http://127.0.0.1:$PORT
CONTAINER=bench-campfire-$PORT
REDIS_CONTAINER=bench-campfire-redis-$PORT
suite() { [[ " $SUITES " = *" $1 "* ]]; }

APPS=rails,django,laravel,laravel-frankenphp-classic,laravel-frankenphp,express,elixir,go,rust,symfony-classic,symfony REPS=3 OUT="" ONE_REP=""
USER_AGENT=${BENCH_USER_AGENT:-}
while [ $# -gt 0 ]; do
  case "$1" in
    --apps) APPS=$2; shift 2 ;;
    --reps) REPS=$2; shift 2 ;;
    --out)  OUT=$2; shift 2 ;;
    --user-agent) USER_AGENT=$2; shift 2 ;;
    --one-rep) ONE_REP="$2 $3"; shift 3 ;; # internal: one app's rep, in its own process
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done
export BENCH_USER_AGENT=$USER_AGENT
USER_AGENT_ARGS=(); [ -n "$USER_AGENT" ] && USER_AGENT_ARGS=(--user-agent "$USER_AGENT")
OUT=${OUT:-$BENCH/results/$(date +%Y%m%d-%H%M%S)}
mkdir -p "$OUT/logs"
OUT=$(cd "$OUT" && pwd)

log() { echo "[$(date +%T)] $*" >&2; }
die() { log "error: $*"; exit 1; }
label() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$LABELS" "$1"; }
lg() { taskset -c "$LOADGEN_CPUS" "$LOADGEN" "$@" "${USER_AGENT_ARGS[@]}"; }
# shellcheck source=lib/apps.sh
. "$BENCH/lib/apps.sh"
mem_anon() { awk '$1=="anon"{print $2}' "$1/memory.stat"; }
mb() { echo $(( ${1:-0} / 1048576 )); }

# ---------------------------------------------------------------------------------------------
# One app's rep (its own process, so a failure is recorded and the next app still runs).

SAMPLER="" PROCMEM="" REP_LOG=""
teardown() {
  [ -n "$SAMPLER" ] && kill "$SAMPLER" 2>/dev/null || true
  [ -n "$PROCMEM" ] && kill "$PROCMEM" 2>/dev/null || true
  if [ -n "$REP_LOG" ] && docker inspect "$CONTAINER" >/dev/null 2>&1; then
    docker logs --tail 300 "$CONTAINER" > "$REP_LOG" 2>&1 || true
  fi
  docker rm -f "$CONTAINER" "$REDIS_CONTAINER" >/dev/null 2>&1 || true
}

# Samples memory.current and anon every 200ms, keeping the maxima in $2.
start_sampler() {
  local cg=$1 out=$2
  ( max_cur=0 max_anon=0
    while [ -d "$cg" ]; do
      cur=$(cat "$cg/memory.current" 2>/dev/null || echo 0); an=$(mem_anon "$cg" 2>/dev/null || echo 0)
      [ "$cur" -gt "$max_cur" ] && max_cur=$cur; [ "$an" -gt "$max_anon" ] && max_anon=$an
      echo "{\"peak_current_mb\": $((max_cur / 1048576)), \"peak_anon_mb\": $((max_anon / 1048576))}" > "$out.tmp" && mv "$out.tmp" "$out"
      sleep 0.2
    done ) &
  SAMPLER=$!
}

# Waits for the 1-minute load average to drop below LOAD_MAX (the previous run's load decays with
# a one-minute time constant), for at most LOAD_WAIT_SECS.
wait_for_quiet() {
  local waited=0
  while awk -v max="$LOAD_MAX" '{exit !($1 >= max)}' /proc/loadavg && [ "$waited" -lt "$LOAD_WAIT_SECS" ]; do
    sleep 10; waited=$((waited + 10))
  done
  log "load before run: $(cut -d' ' -f1-3 /proc/loadavg) (waited ${waited}s)"
}

# Acknowledged requests of a loadgen http result: its 2xx and 3xx responses (loadgen's "ok").
acknowledged() { python3 -c 'import json,sys; print(sum(v for k, v in json.loads(sys.argv[1])["statuses"].items() if 200 <= int(k) < 400))' "$1"; }

jq_append() { python3 -c 'import json,sys; a=json.loads(sys.argv[1]); a.append(json.loads(sys.argv[2])); print(json.dumps(a))' "$1" "$2"; }

run_rep() {
  local app=$1 rep=$2
  local f=$OUT/$app-$rep.json
  REP_LOG=$OUT/logs/$app-$rep.log
  trap teardown EXIT
  trap 'exit 130' INT TERM
  wait_for_quiet
  local load_start; load_start=$(cat /proc/loadavg)
  log "$app rep $rep: starting $(image_for "$app") (load: $(cut -d' ' -f1-3 /proc/loadavg))"
  local cold_ms; cold_ms=$(start_app "$app")
  local cg; cg=$(cgroup_of "$CONTAINER")
  [ -n "$cg" ] && [ -f "$cg/memory.current" ] || die "no cgroup for $CONTAINER"
  local redis_cg=""; needs_redis "$app" && redis_cg=$(cgroup_of "$REDIS_CONTAINER")
  sleep 10
  local idle_cur idle_anon redis_idle=0
  idle_cur=$(mb "$(cat "$cg/memory.current")"); idle_anon=$(mb "$(mem_anon "$cg")")
  [ -n "$redis_cg" ] && redis_idle=$(mb "$(cat "$redis_cg/memory.current")")
  start_sampler "$cg" "$OUT/.$app-$rep.mem"
  log "$app rep $rep: cold start ${cold_ms}ms, idle ${idle_cur}MB (anon ${idle_anon}MB)$([ -n "$redis_cg" ] && echo ", redis sidecar ${redis_idle}MB")"

  local login cookie scrape csrf streams css
  login=$(lg login --base "$BASE" --email "$EMAIL" --password "$PASSWORD") || die "$app: login failed"
  cookie=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["cookie"])' "$login")
  scrape=$(lg scrape --base "$BASE" --cookie "$cookie" --room "$ROOM") || die "$app: scrape failed"
  csrf=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["csrf"] or "")' "$scrape")
  streams=$(python3 -c 'import json,sys; print(",".join(json.loads(sys.argv[1])["streams"]))' "$scrape")
  css=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["css"] or "")' "$scrape")
  log "$app rep $rep: signed in; room page $(python3 -c 'import json,sys; s=json.loads(sys.argv[1]); print(s["status"], s["bytes"], "bytes,", len(s["streams"]), "streams, csrf", "yes" if s["csrf"] else "NO", ", css", s["css"])' "$scrape")"
  { [ -n "$csrf" ] || [ "$(csrf_mode "$app")" = sec-fetch-site ]; } && [ -n "$streams" ] && [ -n "$css" ] ||
    die "$app: the room page lacks a CSRF token, stream sources or a stylesheet (scrape: $scrape)"
  [ -n "$csrf" ] || log "$app rep $rep: no CSRF token on the page; posts rely on Sec-Fetch-Site: same-origin (csrf_mode $(csrf_mode "$app"))"
  # Untimed: what the measured pages contain, to compare the work per request across apps.
  local pages; pages=$(python3 "$BENCH/lib/validate.py" page "$BASE" "$cookie" "room_show=/rooms/$ROOM" \
    "messages_page=/rooms/$ROOM/messages?before=$BEFORE" "sidebar=/users/me/sidebar" "search=/searches?q=coffee")
  log "$app rep $rep: pages $(python3 "$BENCH/lib/validate.py" pages-summary "$pages")"

  local routes=(
    "room_show|/rooms/$ROOM"
    "messages_page|/rooms/$ROOM/messages?before=$BEFORE"
    "sidebar|/users/me/sidebar"
    "search|/searches?q=coffee"
    "avatar|/users/$AVATAR/avatar"
    "static_css|$css"
    "up|/up"
    "post_message|POST"
  )
  local http_json="[]" r name path args res writes_json=null write_mark="" acked=0
  local db=$WORK/$app/db/production.sqlite3
  suite http || routes=()
  for r in "${routes[@]}"; do
    name=${r%%|*}; path=${r#*|}
    if [ "$path" = POST ]; then
      args=(--post-room "$WRITE_ROOM" --csrf "$csrf")
      write_mark=$(as_db_owner "$db" python3 "$BENCH/lib/validate.py" writes-mark "$db")
    else
      args=(--path "$path")
    fi
    res=$(lg http --base "$BASE" --cookie "$cookie" "${args[@]}" --conc 4 --duration 2) # warm up
    [ "$path" = POST ] && acked=$((acked + $(acknowledged "$res")))
    for c in $HTTP_CONCS; do
      res=$(lg http --base "$BASE" --cookie "$cookie" "${args[@]}" --conc "$c" --duration "$HTTP_SECS")
      [ "$path" = POST ] && acked=$((acked + $(acknowledged "$res")))
      http_json=$(python3 -c 'import json,sys; a=json.loads(sys.argv[1]); r=json.loads(sys.argv[2]); r["route"]=sys.argv[3]; a.append(r); print(json.dumps(a))' "$http_json" "$res" "$name")
      log "$app rep $rep: $name c=$c $(python3 -c 'import json,sys; r=json.loads(sys.argv[1]); print(r["rps"], "rps p50", r["latency"].get("p50_ms"), "p99", r["latency"].get("p99_ms"), r["statuses"], "err", r["errors"], "avg", r["avg_bytes"], "B")' "$res")"
    done
    if [ "$path" = POST ]; then
      # Before the cable and upload suites post anything else: were the acknowledged posts persisted?
      writes_json=$(as_db_owner "$db" python3 "$BENCH/lib/validate.py" writes "$db" "$write_mark" "$acked" "$WRITE_SETTLE_SECS")
      log "$app rep $rep: writes $(python3 -c 'import json,sys; w=json.loads(sys.argv[1]); print("ok" if w["ok"] else "FAILED", {k: w.get(k) for k in ("acknowledged", "new_messages", "with_bench_rich_text", "in_fts", "fts_match", "integrity", "settle_ms")}, "; ".join(w.get("problems", [])))' "$writes_json")"
    fi
  done

  local cable_json="[]" n upload_json='{}' upload_check='null' clients=""
  suite cable && clients=$CABLE_CLIENTS
  for n in $clients; do
    local pm=$OUT/.$app-$rep-cable$n
    taskset -c "$PROCMEM_CPUS" python3 "$BENCH/lib/procmem.py" sample "$cg" "$pm.jsonl" & PROCMEM=$!
    local res; res=$(lg cable --base "$BASE" --cookie "$cookie" --room "$ROOM" --csrf "$csrf" --streams "$streams" \
      --clients "$n" --tput-secs "$CABLE_TPUT_SECS" --posters "$CABLE_POSTERS" 2> "$pm.stderr")
    sleep 0.5; kill "$PROCMEM" 2>/dev/null || true; wait "$PROCMEM" 2>/dev/null || true; PROCMEM=""
    res=$(python3 -c 'import json,sys; r=json.loads(sys.argv[1]); r["process_memory"]=json.loads(sys.argv[2]); print(json.dumps(r))' \
      "$res" "$(python3 "$BENCH/lib/procmem.py" phases "$pm.jsonl" "$pm.stderr")")
    cable_json=$(jq_append "$cable_json" "$res")
    log "$app rep $rep: cable $n clients $(python3 -c 'import json,sys; r=json.loads(sys.argv[1]); l=r["latency"]; t=r["throughput"]; print("ready", r["ready"], "failed", r["failed"], "| paced", l["complete"], "/", l["messages"], "all p50", l["all_clients"].get("p50_ms"), "p99", l["all_clients"].get("p99_ms"), "| tput", t["delivered_msgs_per_sec"], "msg/s", t["complete"], "/", t["posted"])' "$res")"
    sleep 2
  done

  if suite upload; then
    upload_json=$(lg upload --base "$BASE" --cookie "$cookie" --room "$WRITE_ROOM" --csrf "$csrf" --file "$FIXTURE" --reps "$UPLOAD_REPS")
    log "$app rep $rep: upload median $(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["median_total_ms"])' "$upload_json")ms"
    # Not timed: one more upload whose own thumbnail (not the author's avatar) must come back as an image.
    upload_check=$(python3 "$BENCH/lib/validate.py" thumbnail "$BASE" "$cookie" "$WRITE_ROOM" "$csrf" "$FIXTURE")
    log "$app rep $rep: upload thumbnail $(python3 -c 'import json,sys; t=json.loads(sys.argv[1]); print("ok" if t["ok"] else "FAILED", t.get("hops"), t.get("thumb_kind"), t.get("thumb_bytes"), "bytes", t.get("error") or "")' "$upload_check")"
  fi

  sleep 0.5
  local peak; peak=$(cat "$OUT/.$app-$rep.mem")
  local cg_peak; cg_peak=$(mb "$(cat "$cg/memory.peak" 2>/dev/null || echo 0)")
  local redis_peak=0; [ -n "$redis_cg" ] && redis_peak=$(mb "$(cat "$redis_cg/memory.peak" 2>/dev/null || echo 0)")
  kill "$SAMPLER" 2>/dev/null || true; SAMPLER=""
  python3 - "$f" "$app" "$rep" "$(image_for "$app")" "$(image_info "$(image_for "$app")")" "$(process_model "$app")" "$(user_for "$app")" \
    "$cold_ms" "$idle_cur" "$idle_anon" "$peak" "$cg_peak" "$redis_idle" "$redis_peak" "$([ -n "$redis_cg" ] && echo 1 || echo 0)" \
    "$scrape" "$http_json" "$cable_json" "$upload_json" "$upload_check" "$writes_json" "$pages" "$(csrf_mode "$app")" "$load_start" "$(cat /proc/loadavg)" <<'PY'
import json, sys
(f, app, rep, image, info, model, user, cold, idle_cur, idle_anon, peak, cg_peak, redis_idle, redis_peak, has_redis,
 scrape, http, cable, upload, upload_check, writes, pages, csrf_mode, load0, load) = sys.argv[1:]
platform, image_id, revision, created = (info.split(" ") + ["", "", "", ""])[:4]
memory = {"idle_current_mb": int(idle_cur), "idle_anon_mb": int(idle_anon), **json.loads(peak), "cgroup_peak_mb": int(cg_peak)}
if has_redis == "1":
    memory["sidecar_redis"] = {"idle_current_mb": int(redis_idle), "cgroup_peak_mb": int(redis_peak)}
s = json.loads(scrape)
json.dump({
  "app": app, "rep": int(rep),
  "image": {"ref": image, "id": image_id, "platform": platform, "revision": revision, "created": created},
  "process_model": model, "user": user, "cold_start_ms": int(cold), "memory": memory,
  "scrape": {"status": s["status"], "bytes": s["bytes"], "csrf": bool(s["csrf"]), "streams": s["streams"], "css": s["css"], "js": s["js"]},
  "http": json.loads(http), "cable": json.loads(cable), "upload": json.loads(upload), "upload_check": json.loads(upload_check), "writes": json.loads(writes),
  "pages": json.loads(pages), "csrf_mode": csrf_mode,
  "loadavg_start": load0, "loadavg_end": load,
}, open(f, "w"), indent=1)
PY
  rm -f "$OUT/.$app-$rep.mem"
  log "$app rep $rep: $(python3 "$BENCH/lib/validate.py" rep "$f")"
  teardown
  rm -rf "${WORK:?}/$app"
  log "$app rep $rep: done -> $f"
}

if [ -n "$ONE_REP" ]; then
  ROOM=$(label rooms.watercooler)        # the busy room (131 messages)
  WRITE_ROOM=$(label rooms.hq)           # writes and uploads go here, so the busy room stays put
  BEFORE=$(label messages.busy_060)      # a page in the middle of the busy room
  AVATAR=$(label avatar_tokens.jason)    # image avatar
  EMAIL=$(label emails.david)
  PASSWORD=$(label passwords.all)
  # shellcheck disable=SC2086
  run_rep $ONE_REP
  exit 0
fi

# ---------------------------------------------------------------------------------------------
# The whole run.

[ -f "$SEED/db/production.sqlite3" ] && [ -f "$ENV_FILE" ] || die "no seed in $SEED: run bench/bin/setup first (inside bench/bin/runner)"
[ -f "$FIXTURE" ] || die "missing $FIXTURE (bench/bin/setup checks out once-campfire-rust's reference/)"
[ -d /sys/fs/cgroup ] && command -v taskset >/dev/null || die "run this inside the runner: bench/bin/runner bench/run ..."
case "$WORK" in /mnt/mac/*|/Users/*|/Volumes/*|"$ROOT"/*) die "BENCH_WORK=$WORK is on a macOS-shared path; SQLite's WAL isn't safe there" ;; esac
mkdir -p "$WORK"
taskset -pc "$HARNESS_CPUS" $$ >/dev/null # this script, its samplers and helpers stay off the app's and loadgen's CPUs

ORDER=() seen=" "
for a in ${APPS//,/ }; do a=$(canonical "$a"); [[ "$seen" = *" $a "* ]] || { ORDER+=("$a"); seen+="$a "; }; done
native=linux/$(docker version -f '{{.Server.Arch}}')
for app in "${ORDER[@]}"; do
  img=$(image_for "$app")
  docker image inspect "$img" >/dev/null 2>&1 || die "image $img ($app) not found; see bench/README.md"
  plat=$(image_info "$img" | cut -d' ' -f1)
  [[ "$plat" = "$native"* ]] || [ -n "${ALLOW_EMULATED:-}" ] || die "$img is $plat, not $native: it would run emulated (ALLOW_EMULATED=1 to go ahead)"
done
if [[ " ${ORDER[*]} " = *" django "* ]] && needs_redis django; then
  docker image inspect "$REDIS_IMAGE" >/dev/null 2>&1 || docker pull -q --platform "$native" "$REDIS_IMAGE" >/dev/null
fi
[ -x "$LOADGEN" ] || (cd "$RUST/bench/loadgen" && CARGO_TARGET_DIR=$RUST/target/bench cargo build --release -q)

exec 2> >(tee -a "$OUT/run.log" >&2)
cleanup() { docker rm -f "$CONTAINER" "$REDIS_CONTAINER" >/dev/null 2>&1 || true; }
trap cleanup EXIT
trap 'log "interrupted"; exit 130' INT TERM

{
  echo "date: $(date -Is)"
  echo "host: ${HOST_CPU:-$(lscpu | sed -n 's/^Model name: *//p' | head -1)}; Docker VM: $(docker info -f '{{.OperatingSystem}}, {{.NCPU}} vCPUs, {{.MemTotal}} B') kernel $(uname -r)"
  echo "host power: ${HOST_POWER:-unknown}"
  echo "server cpus: $SERVER_CPUS (nproc $(ncpu)); loadgen cpus: $LOADGEN_CPUS; harness cpus: $HARNESS_CPUS; network: host; port: $PORT"
  echo "workloads: suites [$SUITES]; http ${HTTP_SECS}s at c=[$HTTP_CONCS] (2s warm-up at c=4); cable clients [$CABLE_CLIENTS], ${CABLE_TPUT_SECS}s saturation with $CABLE_POSTERS posters; upload reps $UPLOAD_REPS"
  echo "load wait: LOAD_MAX=$LOAD_MAX, LOAD_WAIT_SECS=$LOAD_WAIT_SECS; write check settle: ${WRITE_SETTLE_SECS}s; containers running before the run: $(docker ps -q | wc -l)"
  echo "user agent: ${USER_AGENT:-(none)}"
  echo "work dir: $WORK ($(df -T "$WORK" | awk 'NR==2{print $2}'))"
  echo "harness: campfire-symfony bench/run @ $(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '(no commit)') ($(git -C "$ROOT" status --porcelain -- bench 2>/dev/null | wc -l) changed files in bench/); once-campfire-rust @ $(git -C "$RUST" rev-parse --short HEAD) (loadgen, seed)"
  echo "seed: $(sha256sum "$SEED/db/production.sqlite3" | cut -c1-16) production.sqlite3; loadgen: $(sha256sum "$LOADGEN" | cut -c1-16)"
  for app in "${ORDER[@]}"; do
    img=$(image_for "$app"); read -r plat id rev created <<<"$(image_info "$img")"
    echo "$app image: $img $plat $id revision ${rev:-unknown} source $(image_source "$img" || true) created $created digests $(docker image inspect -f '{{join .RepoDigests ","}}' "$img")"
    echo "$app process model: $(process_model "$app"); user $(user_for "$app")"
  done
  if [[ " ${ORDER[*]} " = *" django "* ]] && needs_redis django; then
    echo "redis sidecar image: $REDIS_IMAGE $(image_info "$REDIS_IMAGE" | cut -d' ' -f1,2) $(docker image inspect -f '{{join .RepoDigests ","}}' "$REDIS_IMAGE")"
  fi
} > "$OUT/env.txt"
cat "$OUT/env.txt" >&2

failed=0
for rep in $(seq 1 "$REPS"); do
  apps=("${ORDER[@]}")
  if [ $((rep % 2)) -eq 0 ]; then apps=(); for ((i = ${#ORDER[@]} - 1; i >= 0; i--)); do apps+=("${ORDER[$i]}"); done; fi
  for app in "${apps[@]}"; do
    echo "$(date +%T) $app rep $rep start: $(uptime)" >> "$OUT/uptime.log"
    rm -f "$OUT/$app-$rep.failed"
    if ! "$0" --one-rep "$app" "$rep" --out "$OUT" --apps "$app"; then
      failed=1
      echo "rep failed; see logs/$app-$rep.log and run.log" > "$OUT/$app-$rep.failed"
      log "$app rep $rep: FAILED"
      [ -z "${FAIL_FAST:-}" ] || break 2
    elif ! python3 -c 'import json,sys; sys.exit(0 if json.load(open(sys.argv[1]))["validation"]["ok"] else 1)' "$OUT/$app-$rep.json"; then
      failed=1
    fi
    echo "$(date +%T) $app rep $rep end:   $(uptime)" >> "$OUT/uptime.log"
  done
done
"$BENCH/report" "$OUT" | tee "$OUT/report.md"
[ "$failed" = 0 ] || log "some reps failed or did not validate: see the Validation section of $OUT/report.md"
exit "$failed"
